# ---------------------------------------------------------------
# Project PokéWatch — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# Database. Local dev default is SQLite under ./data. Docker Compose uses Postgres.
# DATABASE_URL=sqlite:///./data/pokewatch.db
POSTGRES_PASSWORD=CHANGE_ME

# --- Retailers --------------------------------------------------
# Best Buy Products API key: https://developer.bestbuy.com (see docs/FEASIBILITY.md re: email domains)
BESTBUY_API_KEY=
# Optional: Pokémon TCG API key (higher rate limit for set release dates)
POKEMONTCG_API_KEY=
# Reputable Shopify-based hobby stores: "Name|domain|collection-handle;Name2|domain2|collection"
# Only add stores whose terms allow it; robots.txt is enforced automatically.
SHOPIFY_STORES=
# ZIP for Best Buy in-store pickup checks (also settable in the dashboard)
LOCAL_ZIP=

# --- Notifications ----------------------------------------------
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
# Telegram: create a bot with @BotFather, then get your chat id (see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Record alerts without sending them
ALERTS_DRY_RUN=false

# --- Optional AI classification (ambiguous titles only, cached) --
ANTHROPIC_API_KEY=
# POKEWATCH_AI_MODEL=claude-opus-5-5

# --- Misc -------------------------------------------------------
LOG_LEVEL=INFO
JSON_LOGS=true
HTTP_TIMEOUT_S=15
# Identify the bot honestly to the sites it reads
POKEWATCH_USER_AGENT=PokeWatch/0.2 (personal stock-alert bot; low-frequency)
