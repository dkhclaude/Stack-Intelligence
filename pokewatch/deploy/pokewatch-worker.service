# systemd unit for running the worker WITHOUT Docker (Raspberry Pi / small VPS).
# Install: sudo cp deploy/pokewatch-worker.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now pokewatch-worker
[Unit]
Description=PokeWatch monitoring worker
After=network-online.target
Wants=network-online.target

[Service]
User=pokewatch
WorkingDirectory=/opt/pokewatch
EnvironmentFile=/opt/pokewatch/.env
ExecStart=/opt/pokewatch/.venv/bin/pokewatch worker
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
